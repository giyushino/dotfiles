# Red theme colors

# LS_COLORS
set -gx LS_COLORS "di=0;31:fi=1;37"

# Fish shell colors
set -U fish_color_autosuggestion '#8b5a5a'
set -U fish_color_cancel normal
set -U fish_color_command '#cc6666'
set -U fish_color_comment '#5a4a4a'
set -U fish_color_cwd '#cc6666'
set -U fish_color_cwd_root '#e06c75'
set -U fish_color_end '#cc6666'
set -U fish_color_error '#e06c75'
set -U fish_color_escape '#d19a66'
set -U fish_color_history_current --bold
set -U fish_color_host '#cc6666'
set -U fish_color_host_remote '#e06c75'
set -U fish_color_normal '#c5c5c5'
set -U fish_color_operator '#cc6666'
set -U fish_color_param '#b48ead'
set -U fish_color_quote '#d19a66'
set -U fish_color_redirection '#cc6666'
set -U fish_color_search_match '#cc6666' --background='#3a2a2a'
set -U fish_color_selection '#cc6666' --bold --background='#3a2a2a'
set -U fish_color_status '#e06c75'
