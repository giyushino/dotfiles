# Blue theme colors

# LS_COLORS
set -gx LS_COLORS "di=0;34:fi=1;34"

# Fish shell colors
set -U fish_color_autosuggestion normal
set -U fish_color_cancel -r
set -U fish_color_command normal
set -U fish_color_comment brred
set -U fish_color_cwd green
set -U fish_color_cwd_root brred
set -U fish_color_end green
set -U fish_color_error blue
set -U fish_color_escape blue
set -U fish_color_history_current --bold
set -U fish_color_host yellow
set -U fish_color_host_remote yellow
set -U fish_color_normal F0C3A2
set -U fish_color_operator blue
set -U fish_color_param normal
set -U fish_color_quote yellow
set -U fish_color_redirection blue --bold
set -U fish_color_search_match white --background=brblack
set -U fish_color_selection white --bold --background=brblack
set -U fish_color_status brred
set -U fish_color_user blue
set -U fish_color_valid_path --underline
set -U fish_pager_color_completion normal
set -U fish_pager_color_description yellow -i
set -U fish_pager_color_prefix normal --bold --underline
set -U fish_pager_color_progress normal --background=blue
set -U fish_pager_color_selected_background -r
