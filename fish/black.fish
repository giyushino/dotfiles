# Black theme colors

# LS_COLORS
set -gx LS_COLORS "di=0;37:fi=1;97"

# Fish shell colors
set -U fish_color_autosuggestion white
set -U fish_color_cancel normal
set -U fish_color_command '#cccccc'
set -U fish_color_comment brblack
set -U fish_color_cwd white
set -U fish_color_cwd_root brwhite
set -U fish_color_end '#cccccc'
set -U fish_color_error '#cccccc'
set -U fish_color_escape white
set -U fish_color_history_current --bold
set -U fish_color_host white
set -U fish_color_host_remote brwhite
set -U fish_color_normal white
set -U fish_color_operator '#cccccc'
set -U fish_color_param '#cccccc'
set -U fish_color_quote '#cccccc'
set -U fish_color_redirection white
set -U fish_color_search_match white --background=brblack
set -U fish_color_selection white --bold --background=brblack
set -U fish_color_status brwhite
set -U fish_color_user brwhite
set -U fish_color_valid_path normal
set -U fish_pager_color_completion '#cccccc'
set -U fish_pager_color_description '#777777'
set -U fish_pager_color_prefix '#eeeeee' --bold --underline
set -U fish_pager_color_progress --background='#333333'
set -U fish_pager_color_selected_background --background='#333333'
