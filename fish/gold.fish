# Gold theme colors (gold on white)

# LS_COLORS — gold directories/files
set -gx LS_COLORS "di=0;33:fi=0;33"

# Fish shell colors (gold ink on a light/cream background)
set -U fish_color_autosuggestion '#C9A52E'
set -U fish_color_cancel normal
set -U fish_color_command '#A8841C'
set -U fish_color_comment '#B8A45C'
set -U fish_color_cwd '#D4AF37'
set -U fish_color_cwd_root '#C9952E'
set -U fish_color_end '#A8841C'
set -U fish_color_error '#C9952E'
set -U fish_color_escape '#B58A1E'
set -U fish_color_history_current --bold
set -U fish_color_host '#C9A227'
set -U fish_color_host_remote '#D4AF37'
set -U fish_color_normal '#4A3A10'
set -U fish_color_operator '#B58A1E'
set -U fish_color_param '#4A3A10'
set -U fish_color_quote '#BF9B30'
set -U fish_color_redirection '#B58A1E'
set -U fish_color_search_match --background='#F0E4B0'
set -U fish_color_selection '#4A3A10' --bold --background='#F0E4B0'
set -U fish_color_status '#C9952E'
set -U fish_color_user '#D4AF37'
set -U fish_color_valid_path --underline
set -U fish_pager_color_completion '#4A3A10'
set -U fish_pager_color_description '#B8A45C'
set -U fish_pager_color_prefix '#A8841C' --bold --underline
set -U fish_pager_color_progress --background='#F0E4B0'
set -U fish_pager_color_selected_background --background='#F0E4B0'
