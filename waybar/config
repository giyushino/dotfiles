{
    "layer": "top",
    "spacing": 0,
    "height": 0,
    
    "margin-top": 0,
    "margin-right": 4,
    "margin-bottom": 0,
    "margin-left": 4,

    "modules-left": [
        "cpu",
        "memory",
        "custom/gpu",
        "custom/temperature",
    ],

    "modules-center": [
        "clock", 
        "hyprland/workspaces"
    ],

    "modules-right": [
        "battery",
        "network",
        "backlight",
        "pulseaudio", 
    ],


    "hyprland/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "tooltip": false
    },

    "tray": {
        "spacing": 10,
        "tooltip": false
    },

    "clock": {
        "format": "{:%I:%M %p - %a, %d %b %Y}",
        "tooltip": false
    },
    
    "backlight": {
        "format": "brightness {percent}%",
        "tooltip": false
    },
    "cpu": {
        "format": "cpu {usage}%",
        "interval": 2,

        "states": {
            "critical": 90
        }
    },
    "custom/gpu": {
        "exec": "~/.config/waybar/gpu_usage.sh",
        "interval": 2,
        "tooltip": false
    },
    "custom/temperature": {
        "exec": "~/.config/waybar/get_temperature.sh",
        "interval": 2
    },
    "memory": {
        "format": "mem {percentage}%",
        "interval": 2,

        "states": {
            "critical": 80
        }
    },
    "battery": {
        "format": "bat {capacity}%",
        "interval": 5,
        "states": {
            "warning": 20,
            "critical": 10
        },
        "tooltip": false
    },
    "network": {
        "format-wifi" : "wifi {bandwidthDownBits}",
        "format-ethernet": "enth {bandwidthDownBits}",
        "format-disconnected" : "no network",
        "interval": 5,
        "tooltip": false
    },
    "pulseaudio": {
        "scroll-step": 5,
        "max-volume": 150,
        "format": "vol {volume}%",
        "format-bluetooth": "vol {volume}%",
        "nospacing": 1,
        "on-click": "pavucontrol",
        "tooltip": false
    },
}
